       int tensor_index, const TfLiteCustomAllocation& allocation,
       int64_t flags = kTfLiteCustomAllocationFlagsNone);
 
+  /// [BIND-FIX] Erase a single tensor's custom allocation entry on the primary
+  /// subgraph. No-op if the tensor has no entry.
+  void EraseCustomAllocationForTensor(int tensor_index);
