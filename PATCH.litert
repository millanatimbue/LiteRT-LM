diff --git a/litert/runtime/compiled_model.cc b/litert/runtime/compiled_model.cc
index 4522eee..a691b48 100644
--- a/litert/runtime/compiled_model.cc
+++ b/litert/runtime/compiled_model.cc
@@ -1428,6 +1428,27 @@ Expected<void> LiteRtCompiledModelT::RegisterBuffer(
 
     for (auto& type : supported_types) {
       if (type == buffer->buffer_type()) {
+        // [BIND-FIX] If this tensor was previously slow-pathed
+        // (kTfLiteCustom), the matching entry in the subgraph's
+        // custom_allocations_ map is now stale. Without removing it, the next
+        // AllocateTensors() will TF_LITE_ENSURE_EQ that the tensor's
+        // allocation_type is still kTfLiteCustom — but we are about to flip it
+        // to kTfLiteNonCpu, which trips the check with "8 != 6". Erase the
+        // stale entry now so the symmetric invariant holds. This matters on
+        // iOS Metal where the same KV-cache tensor can take the slow path on
+        // the first sendMessage of a conversation and the fast path on
+        // subsequent ones.
+        if (tensor->allocation_type == kTfLiteCustom) {
+          if (runner) {
+            if (is_input) {
+              runner->EraseCustomAllocationForInputTensor(tensor_name);
+            } else {
+              runner->EraseCustomAllocationForOutputTensor(tensor_name);
+            }
+          } else {
+            interp_->EraseCustomAllocationForTensor(tensor_index);
+          }
+        }
         // Register tensor buffer if it can be used by the backend.
         buffer->Duplicate();
         LiteRtTensorBufferPtr duplicated_buffer(buffer);
diff --git a/tflite/core/interpreter.h b/tflite/core/interpreter.h
